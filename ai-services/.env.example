# Infrastructure hostnames below match docker-compose.yml.
REDIS_URL=redis://redis:6379/0
MONGO_URL=mongodb://mongodb:27017

# Supported providers: groq or ollama.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_MODEL_SMART=llama-3.3-70b-versatile
LLM_MODEL_FAST=llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=120

# Required when LLM_PROVIDER=groq. GROQ_API is supported only as a legacy alias.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Used when LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional per-agent model overrides.
# LLM_MODEL_CEO=
# LLM_MODEL_PRODUCT_MANAGER=
# LLM_MODEL_ARCHITECT=
# LLM_MODEL_SPRINT_PLANNER=
# LLM_MODEL_RISK=
# LLM_MODEL_TEAM_ALLOCATION=
# LLM_MODEL_TIMELINE=
# LLM_MODEL_INTEGRATION=
