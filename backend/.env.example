# Infrastructure hostnames below match docker-compose.yml.
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://devflow:devflow@postgres:5432/devflow
AI_SERVICES_URL=http://ai-services:8001
AI_INTERNAL_API_KEY=replace-with-a-long-random-production-secret

# Clerk backend credentials. Never expose CLERK_SECRET_KEY to the browser.
CLERK_SECRET_KEY=
CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev
BYPASS_AUTH=true
UNLIMITED_CREDENTIALS=true

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# Orchestration settings.
ORCHESTRATOR_WORKERS=1
RUN_TIMEOUT_SECONDS=1800
EVENT_BUFFER_TTL_SECONDS=86400
